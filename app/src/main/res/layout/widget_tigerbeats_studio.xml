<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_liquid3d_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="TigerBeats Album Art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="TigerBeats Studio"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Armaco MG Edition"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_playback_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#38BDF8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_previous"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⏮"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_play_pause"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="▶"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⏭"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_open_converter"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.4"
            android:layout_marginStart="6dp"
            android:text="Convert"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_open_player"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.3"
            android:layout_marginStart="4dp"
            android:text="Player"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
